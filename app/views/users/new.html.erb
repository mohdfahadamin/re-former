<% if @user.errors.any? %>
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user do |form| %>
    <%= form.label :username %>
    <%= form.text_field :username%>
    
    <%= form.label :email%>
    <%= form.email_field :email %>
    
    <%= form.label :password %>
    <%= form.password_field :password %>
    
    <%= form.submit %>
<% end %>